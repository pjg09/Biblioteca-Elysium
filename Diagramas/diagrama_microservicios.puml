' ============================================================
' INFRAESTRUCTURA TRANSVERSAL
' ============================================================

package "Infraestructura" #EEEEEE {

    class EurekaServer <<infra>> {
        ' Puerto 8761
        ' Service Registry & Discovery
    }

    class RabbitMQ <<infra>> {
        ' Exchange: biblioteca.events (topic)
        ' Puertos: 5672 / 15672
    }

    note right of RabbitMQ
      Routing keys:
      prestamo.registrado
      material.devuelto
      multa.generada
      multa.pagada
      reserva.creada
      reserva.notificada
      reserva.expirada
      usuario.bloqueado.deuda
      usuario.desbloqueo.peticion
    end note
}

' ============================================================
' RELACIONES ENTRE BOUNDED CONTEXTS
' ============================================================

' Llamadas síncronas REST desde BC1
MaterialesClient  ..> "materiales-service :8082\n[BC2 Supporting — Gestión de Materiales]"  : REST GET disponibilidad
UsuariosClient    ..> "usuarios-service :8083\n[BC3 Supporting — Gestión de Usuarios]"      : REST GET estado/límite
MultasClient      ..> "multas-service :8084\n[BC4 Core — Cálculo de Multas]"                : REST GET deuda
PrestamosExternosClient ..> "prestamos-externos-service :8085\n[BC5 Supporting — Préstamos Interbibliotecarios]" : REST POST

' Eventos asíncronos vía RabbitMQ (BC1 → varios)
EventoPublisher ..> RabbitMQ : publica eventos

RabbitMQ ..> MaterialEventHandler       : material.devuelto
RabbitMQ ..> MultaEventHandler          : material.devuelto, multa.pagada
RabbitMQ ..> ReservaEventHandler        : material.devuelto
RabbitMQ ..> CobroEventHandler          : multa.generada
RabbitMQ ..> SancionesACLHandler        : usuario.bloqueado, usuario.desbloqueo
RabbitMQ ..> EventosBibliotecaHandler   : todos los eventos
RabbitMQ ..> EventosEstadisticaHandler  : estadísticas

' BC4 publica MultaGenerada → BC9 crea DeudaPendiente
MultaEventHandler ..> RabbitMQ : multa.generada

' BC9 publica MultaPagada, UsuarioBloqueado → BC3, BC6
CobroService ..> RabbitMQ : multa.pagada, usuario.desbloqueo

' BC8 publica eventos de reserva
ReservaService ..> RabbitMQ : reserva.creada / notificada / expirada

' CLI conecta a servicios REST
MaterialesClient2 ..> "materiales-service :8082\n[BC2 Supporting — Gestión de Materiales]" : REST
UsuariosClient2   ..> "usuarios-service :8083\n[BC3 Supporting — Gestión de Usuarios]"    : REST
CirculacionClient ..> "circulacion-service :8081\n[BC1 Core — Circulación Bibliográfica]" : REST
MultasClient2     ..> "multas-service :8084\n[BC4 Core — Cálculo de Multas]"              : REST
ReservasClient    ..> "reservas-service :8088\n[BC8 Core — Gestión de Reservas]"          : REST
CobrosClient      ..> "cobros-service :8089\n[BC9 Supporting — Cobro de Multas]"          : REST

' Todos los servicios se registran en Eureka
EurekaServer ..> "circulacion-service :8081\n[BC1 Core — Circulación Bibliográfica]" : discovery
EurekaServer ..> "materiales-service :8082\n[BC2 Supporting — Gestión de Materiales]" : discovery
EurekaServer ..> "usuarios-service :8083\n[BC3 Supporting — Gestión de Usuarios]" : discovery
EurekaServer ..> "multas-service :8084\n[BC4 Core — Cálculo de Multas]" : discovery
EurekaServer ..> "reservas-service :8088\n[BC8 Core — Gestión de Reservas]" : discovery
EurekaServer ..> "cobros-service :8089\n[BC9 Supporting — Cobro de Multas]" : discovery

' ============================================================
' NOTAS ARQUITECTURALES
' ============================================================

note as N1
  <b>Principios SOLID aplicados:</b>
  S — Cada servicio tiene una responsabilidad (BC)
  O — Nuevos tipos de multa = nueva impl. ICalculadorMulta
  L — Agregados sustitutos vía interfaces de estado
  I — REST APIs específicas por BC (no monolítico)
  D — Servicios dependen de interfaces, no implementaciones
end note

note as N2
  <b>Patrones de diseño por BC:</b>
  Builder      → Prestamo, Material, Usuario, Multa, Reserva
  State        → Prestamo, Multa, Reserva (ciclo de vida)
  Strategy     → ICalculadorMulta (por tipo usuario)
  Strategy     → IReglaValidacion (BC1 validaciones)
  Repository   → *JpaRepository por servicio
  Facade       → CirculacionFacade (entry point BC1)
end note

note as N3
  <b>BD por servicio (principio DDD):</b>
  BC1 circulacion   → PostgreSQL :5433
  BC2 materiales    → PostgreSQL :5434
  BC3 usuarios      → PostgreSQL :5435
  BC4 multas        → PostgreSQL :5436
  BC5 externos      → PostgreSQL :5439
  BC6 notificaciones→ MongoDB    :27017
  BC7 reportes      → PostgreSQL :5440
  BC8 reservas      → PostgreSQL :5438
  BC9 cobros        → PostgreSQL :5437
end note

@enduml
