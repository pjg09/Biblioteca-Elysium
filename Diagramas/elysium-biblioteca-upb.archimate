<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="Sistema de Gestión Bibliotecaria Elysium — Arquitectura Empresarial" id="elysium-biblioteca-upb" version="5.0.0">
  <folder name="Strategy" id="id-3773ba8238484d20a62b60c7ef1522eb" type="strategy"/>
  <folder name="Business" id="id-14616b1466f647cbbb100dac4947848b" type="business">
    <element xsi:type="archimate:BusinessActor" name="Bibliotecario" id="actor-bibliotecario"/>
    <element xsi:type="archimate:BusinessActor" name="Usuario Final" id="actor-usuario-final">
      <documentation>Estudiante, Profesor, Investigador o Público General.</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Encargado de Circulación" id="role-encargado-circulacion"/>
    <element xsi:type="archimate:BusinessRole" name="Prestatario" id="role-prestatario"/>
    <element xsi:type="archimate:BusinessRole" name="Gestor de Reservas" id="role-gestor-reservas"/>
    <element xsi:type="archimate:BusinessService" name="Servicio de Préstamo " id="bsvc-prestamo"/>
    <element xsi:type="archimate:BusinessService" name="Servicio de Devolución" id="bsvc-devolucion"/>
    <element xsi:type="archimate:BusinessService" name="Servicio de Renovación" id="bsvc-renovacion"/>
    <element xsi:type="archimate:BusinessService" name="Servicio de Reserva en Cola" id="bsvc-reserva"/>
    <element xsi:type="archimate:BusinessService" name="Servicio de Cálculo de Multas" id="bsvc-multas"/>
    <element xsi:type="archimate:BusinessService" name="Servicio de Cobro " id="bsvc-cobro"/>
    <element xsi:type="archimate:BusinessService" name="Servicio de Catálogo de Materiales" id="bsvc-catalogo"/>
    <element xsi:type="archimate:BusinessService" name="Servicio de Notificación al Usuario" id="bsvc-notificacion"/>
    <element xsi:type="archimate:BusinessProcess" name="Circulación Bibliográfica" id="bproc-circulacion">
      <documentation>Flujo completo: búsqueda → préstamo → devolución → renovación → reserva.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Control de Multas y Bloqueos" id="bproc-multas">
      <documentation>Generar multa → calcular → notificar → pagar/condonar → desbloquear.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Gestión de Reservas" id="bproc-reservas">
      <documentation>Reserva → cola de prioridad → notificación disponibilidad → expiración 24h.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Préstamo" id="bobj-prestamo">
      <documentation>Contrato temporal de uso de un material bibliográfico. Ciclo: ACTIVO → COMPLETADO.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Reserva" id="bobj-reserva">
      <documentation>Separación en cola de espera. Estados: EN_ESPERA → NOTIFICADA → COMPLETADA | CANCELADA | EXPIRADA.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Multa" id="bobj-multa">
      <documentation>Sanción económica por retraso, daño o pérdida. Diferenciada por tipo de usuario.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Material Bibliográfico" id="bobj-material">
      <documentation>Libro, DVD, Revista, EBook. Estados: DISPONIBLE, PRESTADO, RESERVADO, EN_REPARACION, PERDIDO.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Usuario" id="bobj-usuario">
      <documentation>Estudiante (límite 5), Profesor (10), Investigador (15), Público General (3).</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Registro de Pago" id="bobj-pago"/>
    <element xsi:type="archimate:BusinessEvent" name="MaterialDevuelto" id="bevt-material-devuelto">
      <documentation>Dispara BC4 (multas), BC8 (reservas), BC6 (notificaciones), BC7 (reportes).</documentation>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="MultaGenerada" id="bevt-multa-generada">
      <documentation>Dispara BC9 (cobro), BC6 (notificaciones), BC7 (reportes).</documentation>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="ReservaNotificada" id="bevt-reserva-notificada">
      <documentation>Dispara BC6 (notificaciones) y BC1 (habilita retiro).</documentation>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="UsuarioBloqueadoPorDeuda" id="bevt-usuario-bloqueado">
      <documentation>Emitido por BC9 cuando deuda supera umbral. Recibido por BC3.</documentation>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Multa notificada" id="id-f4e13b9cf6a24828874193924b86f68a"/>
    <element xsi:type="archimate:BusinessFunction" name="Gestión de Circulación" id="bfunc-circulacion">
      <documentation>Coordina préstamos, devoluciones, renovaciones y la interacción con materiales, usuarios y multas.</documentation>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Administración de Usuarios" id="bfunc-usuarios">
      <documentation>Gestiona perfiles, límites de préstamo, estados de cuenta y bloqueos.</documentation>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Mantenimiento de Catálogo" id="bfunc-catalogo">
      <documentation>Administra el inventario de materiales, estados físicos y disponibilidad.</documentation>
    </element>
  </folder>
  <folder name="Application" id="id-32ba7010665a4fc7bb7da2d96351b167" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="circulacion-service (BC1)" id="app-circulacion">
      <documentation>Core. Puerto 8081. Préstamos, devoluciones, renovaciones. Depende sincrónicamente de BC2 y BC3. Emite eventos asíncronos.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="materiales-service (BC2)" id="app-materiales">
      <documentation>Supporting. Puerto 8082. Catálogo, disponibilidad, estados físicos. PostgreSQL materiales_db.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="usuarios-service (BC3)" id="app-usuarios">
      <documentation>Supporting. Puerto 8083. Perfiles, límites, estados de cuenta. PostgreSQL usuarios_db.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="multas-service (BC4)" id="app-multas">
      <documentation>Core. Puerto 8084. Cálculo diferenciado por tipo usuario. Estrategia por tipo infracción. PostgreSQL multas_db.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="prestamos-externos-service (BC5)" id="app-prestamos-ext">
      <documentation>Supporting. Puerto 8085. Coordinación con bibliotecas aliadas. PostgreSQL prestamos_externos_db.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="notificaciones-service (BC6)" id="app-notificaciones">
      <documentation>Generic. Puerto 8086. Suscriptor de todos los eventos. MongoDB notificaciones_db.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="reportes-service (BC7)" id="app-reportes">
      <documentation>Generic. Puerto 8087. Observador pasivo, modelos de lectura. PostgreSQL reportes_db.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="reservas-service (BC8)" id="app-reservas">
      <documentation>Core. Puerto 8088. Cola de prioridad, expiración 24h. PostgreSQL reservas_db.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="cobros-service (BC9)" id="app-cobros">
      <documentation>Supporting. Puerto 8089. Pagos, condonaciones, umbral de bloqueo. PostgreSQL cobros_db.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="servicio cli " id="app-cli">
      <documentation>Puerto 8090. Menú interactivo de consola. Llama a BC1-BC4, BC8, BC9 via REST. Profile Docker: cli.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="eureka-server" id="app-eureka">
      <documentation>Service Registry. Puerto 8761. Registro y descubrimiento de todos los microservicios.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationEvent" name="MaterialDevuelto" id="aevt-material-devuelto"/>
    <element xsi:type="archimate:ApplicationEvent" name="MultaGenerada" id="aevt-multa-generada"/>
    <element xsi:type="archimate:ApplicationEvent" name="MultaPagada" id="aevt-multa-pagada"/>
    <element xsi:type="archimate:ApplicationEvent" name="ReservaCreada" id="aevt-reserva-creada"/>
    <element xsi:type="archimate:ApplicationEvent" name="ReservaNotificada" id="aevt-reserva-notificada"/>
    <element xsi:type="archimate:ApplicationEvent" name="ReservaExpirada" id="aevt-reserva-expirada"/>
    <element xsi:type="archimate:ApplicationEvent" name="UsuarioBloqueadoPorDeuda" id="aevt-usuario-bloqueado"/>
    <element xsi:type="archimate:ApplicationService" name="disponibilidad" id="id-e637c2d1a3fa486889a646031b3f10cc"/>
    <element xsi:type="archimate:ApplicationService" name="Notificar" id="id-fc4f9ab3ca074dab9f8b0bd06e82b898"/>
    <element xsi:type="archimate:DataObject" name="Datos de Usuario" id="data-usuario">
      <documentation>id, nombre, email, tipoUsuario, estadoUsuario, limiteMaximoPrestamos</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Datos de Material" id="data-material">
      <documentation>id, titulo, autor, tipo, estado, precio</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Datos de Préstamo" id="data-prestamo">
      <documentation>id, idUsuario, idMaterial, fechaPrestamo, fechaDevolucionEsperada, estado, renovacionesUsadas</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Datos de Multa" id="data-multa">
      <documentation>id, idPrestamo, idUsuario, tipoMulta, montoTotal, estado, fechaGeneracion</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Datos de Pago" id="data-pago">
      <documentation>id, multaId, usuarioId, monto, fechaPago</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Datos de Deuda Pendiente" id="data-deuda">
      <documentation>id, usuarioId, multaId, montoRestante, pagado</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Datos de Reserva" id="data-reserva">
      <documentation>id, idUsuario, idMaterial, posicionCola, estadoReserva, fechaReserva</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Datos de Notificación" id="data-notificacion">
      <documentation>id, usuarioId, tipo, titulo, mensaje, leida, fechaCreacion</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Datos de Solicitud Externa" id="data-solicitud">
      <documentation>id, prestamoId, idUsuario, idMaterial, bibliotecaOrigen, bibliotecaDestino, estado</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Datos de Estadística" id="data-estadistica">
      <documentation>id, tipo, descripcion, valor, fecha</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Gestión de Usuarios" id="afunc-usuarios">
      <documentation>Registrar (POST /usuarios), consultar estado (GET /usuarios/{id}/estado), consultar límite (GET /usuarios/{id}/limite-prestamos), bloquear y desbloquear.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Gestión de Materiales" id="afunc-materiales">
      <documentation>Agregar (POST /materiales), consultar disponibilidad (GET /materiales/{id}/disponibilidad), actualizar estado (PUT /materiales/{id}/estado), listar por tipo.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Gestión de Circulación" id="afunc-circulacion">
      <documentation>Registrar préstamo (POST /prestamos), devolver (PUT /prestamos/{id}/devolver), renovar (PUT /prestamos/{id}/renovar), consultar.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Gestión de Multas" id="afunc-multas">
      <documentation>Calcular multa, consultar deuda pendiente (GET /multas/usuario/{id}/deuda), pagar y condonar.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Gestión de Cobros" id="afunc-cobros">
      <documentation>Registrar pago (POST /cobros), evaluar bloqueo por deuda, consultar deuda restante.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Gestión de Reservas" id="afunc-reservas">
      <documentation>Crear reserva (POST /reservas), notificar disponibilidad (PUT /reservas/{id}/notificar), cancelar, limpiar expiradas (@Scheduled).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Gestión de Notificaciones" id="afunc-notificaciones">
      <documentation>Enviar notificación, consultar (GET /notificaciones), marcar leída (PUT /notificaciones/{id}/leer).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Gestión de Reportes" id="afunc-reportes">
      <documentation>Registrar estadísticas desde eventos y generar reportes (GET /reportes/estadisticas).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Gestión de Préstamos Externos" id="afunc-externos">
      <documentation>Crear solicitud (POST /solicitudes-externas), autorizar, rechazar y consultar.</documentation>
    </element>
  </folder>
  <folder name="Technology &amp; Physical" id="id-9fda60bcbdca4bccbbae54ce4f2fda47" type="technology">
    <element xsi:type="archimate:Device" name="Servidor Host Linux" id="device-host">
      <documentation>Ubuntu/Linux con Docker 29.x y Docker Compose v5. Grupo docker configurado sin sudo.</documentation>
    </element>
    <element xsi:type="archimate:CommunicationNetwork" name="Docker Network (microservicios_default)" id="net-docker">
      <documentation>Red bridge interna. Permite resolución de nombres de servicio entre contenedores.</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="Eclipse Temurin JRE 17 Alpine" id="sw-jre-17"/>
    <element xsi:type="archimate:SystemSoftware" name="Eclipse Temurin JRE 21 Alpine" id="sw-jre-21">
      <documentation>Usado exclusivamente por eureka-server (JAR compilado con Java 21).</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="RabbitMQ 3.12-management" id="sw-rabbitmq">
      <documentation>Bus de mensajería. Puerto 5672 (AMQP), 15672 (UI). Exchange tipo topic: biblioteca.events.</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="PostgreSQL 16 — circulacion_db" id="sw-postgres-circ">
      <documentation>Puerto host: 5433. Tablas: prestamos.</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="PostgreSQL 16 — materiales_db" id="sw-postgres-mat">
      <documentation>Puerto host: 5434. Tablas: materiales.</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="PostgreSQL 16 — usuarios_db" id="sw-postgres-usr">
      <documentation>Puerto host: 5435. Tablas: usuarios.</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="PostgreSQL 16 — multas_db" id="sw-postgres-mul">
      <documentation>Puerto host: 5436. Tablas: multas.</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="PostgreSQL 16 — cobros_db" id="sw-postgres-cob">
      <documentation>Puerto host: 5437. Tablas: deudas_pendientes, registros_pago.</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="PostgreSQL 16 — reservas_db" id="sw-postgres-res">
      <documentation>Puerto host: 5438. Tablas: reservas.</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="PostgreSQL 16 — prestamos_externos_db" id="sw-postgres-ext">
      <documentation>Puerto host: 5439. Tablas: solicitudes_externas.</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="PostgreSQL 16 — reportes_db" id="sw-postgres-rep">
      <documentation>Puerto host: 5440. Tablas: estadisticas.</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="MongoDB 7 — notificaciones_db" id="sw-mongodb">
      <documentation>Puerto host: 27017. Colección: notificaciones (documentos).</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="Netflix Eureka Server" id="sw-eureka-server">
      <documentation>Puerto 8761. Service registry y discovery para todos los microservicios.</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="Maven 3.9 (Docker build stage)" id="sw-maven">
      <documentation>Stage de build en Dockerfile multi-etapa. mvn install -N + mvn install -f biblioteca-commons/pom.xml.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Container: circulacion-service" id="node-circ">
      <documentation>Puerto 8081. Imagen: microservicios-circulacion-service.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Container: materiales-service" id="node-mat">
      <documentation>Puerto 8082.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Container: usuarios-service" id="node-usr">
      <documentation>Puerto 8083.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Container: multas-service" id="node-mul">
      <documentation>Puerto 8084.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Container: prestamos-externos-service" id="node-ext">
      <documentation>Puerto 8085.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Container: notificaciones-service" id="node-not">
      <documentation>Puerto 8086.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Container: reportes-service" id="node-rep">
      <documentation>Puerto 8087.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Container: reservas-service" id="node-res">
      <documentation>Puerto 8088.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Container: cobros-service" id="node-cob">
      <documentation>Puerto 8089.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Container: cli-service" id="node-cli">
      <documentation>Puerto 8090. Profile Docker: cli. Lanzado con: docker compose --profile cli run --rm cli-service.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Container: eureka-server" id="node-eureka">
      <documentation>Puerto 8761. JAR precompilado con Java 21.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Container: rabbitmq" id="node-rabbit">
      <documentation>Puertos 5672, 15672.</documentation>
    </element>
    <element xsi:type="archimate:Artifact" name="circulacion-service-1.0.0.jar" id="art-jar-circ"/>
    <element xsi:type="archimate:Artifact" name="materiales-service-1.0.0.jar" id="art-jar-mat"/>
    <element xsi:type="archimate:Artifact" name="usuarios-service-1.0.0.jar" id="art-jar-usr"/>
    <element xsi:type="archimate:Artifact" name="multas-service-1.0.0.jar" id="art-jar-mul"/>
    <element xsi:type="archimate:Artifact" name="biblioteca-commons-1.0.0.jar" id="art-commons">
      <documentation>Librería compartida: eventos de dominio, enumeraciones, objetos de valor, interfaces de patrones.</documentation>
    </element>
    <element xsi:type="archimate:Artifact" name="prestamos-externos-service-1.0.0.jar" id="art-jar-ext"/>
    <element xsi:type="archimate:Artifact" name="notificaciones-service-1.0.0.jar" id="art-jar-not"/>
    <element xsi:type="archimate:Artifact" name="reportes-service-1.0.0.jar" id="art-jar-rep"/>
    <element xsi:type="archimate:Artifact" name="reservas-service-1.0.0.jar" id="art-jar-res"/>
    <element xsi:type="archimate:Artifact" name="cobros-service-1.0.0.jar" id="art-jar-cob"/>
    <element xsi:type="archimate:Artifact" name="cli-service-1.0.0.jar" id="art-jar-cli"/>
    <element xsi:type="archimate:Artifact" name="eureka-server-1.0.0.jar" id="art-jar-eur"/>
  </folder>
  <folder name="Motivation" id="id-f941e377aa73436bb7a07dc054dd5be5" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Biblioteca" id="stk-biblioteca">
      <documentation>Institución responsable de la gestión de recursos bibliográficos y acceso cultural.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Usuario Biblioteca" id="stk-usuario">
      <documentation>Estudiante, Profesor, Investigador o Público General con acceso al sistema.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Gestión manual de préstamos" id="drv-gestion-manual">
      <documentation>Procesos en papel generan errores, pérdida de trazabilidad y cuellos de botella en mostrador.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Cálculo diferenciado de sanciones" id="drv-sancion-diferenciada">
      <documentation>Distintos tipos de usuario requieren reglas de multa específicas que ningún sistema genérico resuelve.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Acceso justo a recursos" id="drv-acceso-justo">
      <documentation>Cola de reservas manual no garantiza equidad ni notificación oportuna al siguiente usuario.</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Maximizar disponibilidad de materiales" id="goal-disponibilidad"/>
    <element xsi:type="archimate:Goal" name="Trazabilidad completa de transacciones" id="goal-trazabilidad"/>
    <element xsi:type="archimate:Goal" name="Automatización de multas y bloqueos" id="goal-automatizacion"/>
    <element xsi:type="archimate:Goal" name="Arquitectura escalable " id="goal-escalabilidad"/>
    <element xsi:type="archimate:Requirement" name="Principios SOLID en cada servicio" id="req-solid">
      <documentation>SRP, OCP, LSP, ISP, DIP aplicados en la implementación de cada Bounded Context.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Segmentación del dominio" id="req-ddd">
      <documentation>Cada BC encapsula su dominio con agregados, eventos y lenguaje ubicuo propios.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Comunicación asíncrona por eventos de dominio" id="req-eventos-dominio">
      <documentation>RabbitMQ como bus de eventos; routing keys por tipo de evento.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Despliegue de componentes en contenedores independientes" id="req-docker">
      <documentation>Cada microservicio con su propia base de datos y Dockerfile multi-stage.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Procesos Manuales Ineficientes" id="asmt-manual">
      <documentation>Préstamos, reservas y multas gestionadas en papel generan errores operativos, pérdida de trazabilidad y cuellos de botella en mostrador.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Reglas de Multa Heterogéneas" id="asmt-multas">
      <documentation>Cada tipo de usuario (estudiante, profesor, investigador, público general) requiere reglas de cálculo de multa distintas que ningún sistema genérico resuelve.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Sistema Monolítico no Escalable" id="asmt-monolito">
      <documentation>El backend actual es monolítico: desplegar cambios afecta todo el sistema y dificulta la escalabilidad independiente de cada módulo.</documentation>
    </element>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-d17fbfc664674c128c342e9657504ed6" type="implementation_migration"/>
