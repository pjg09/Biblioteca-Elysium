}

Multa <|-- MultaPorRetraso
Multa <|-- MultaPorDano
Multa <|-- MultaPorPerdida

Multa --> MultaPagada : emite
Multa --> MultaCondonada : emite

' ============================================================
' RELACIONES ENTRE ENTIDADES
' ============================================================

Usuario "1" -- "0..*" Transaccion : realiza
Material "1" -- "0..*" Transaccion : involucrado
Prestamo "1" -- "0..*" Multa : genera
Usuario "1" -- "0..*" Multa : tiene
MultaPorDano "1" *-- "1..*" Dano : contiene

' ============================================================
' STATE PATTERN — PRÉSTAMO
' ============================================================

interface IEstadoPrestamo <<interface>> {
    +puedeRenovarse(prestamo: Prestamo) : ResultadoValidacion
    +devolver(prestamo: Prestamo) : Resultado
    +obtenerEstado() : EstadoTransaccion
}

class PrestamoActivoState <<service>> {
    +puedeRenovarse(prestamo: Prestamo) : ResultadoValidacion
    +devolver(prestamo: Prestamo) : Resultado
    +obtenerEstado() : EstadoTransaccion
}

class PrestamoCompletadoState <<service>> {
    +puedeRenovarse(prestamo: Prestamo) : ResultadoValidacion
    +devolver(prestamo: Prestamo) : Resultado
    +obtenerEstado() : EstadoTransaccion
}

IEstadoPrestamo <|.. PrestamoActivoState
IEstadoPrestamo <|.. PrestamoCompletadoState
Prestamo --> IEstadoPrestamo : delega estado

