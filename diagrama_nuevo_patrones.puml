}

class Resultado {
    -bool exito
    -string mensaje
    -object data
    +GetExito() : bool
    +GetMensaje() : string
    +{static} Exitoso(msg, data) : Resultado
    +{static} Fallido(msg) : Resultado
}

class Evaluacion {
    -bool materialUsable
