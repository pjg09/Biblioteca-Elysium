    +TieneUsuario() : bool
    +TieneMaterial() : bool
}

class ContextoMulta {
    -string idPrestamo
    -string idMaterial
    -string idUsuario
    -DateTime fechaActual
    -Evaluacion evaluacion
    -TipoMulta tipoMulta
    ..Añadidos Fase 2 (datos pre-resueltos)..
    -int diasRetraso
    -TipoUsuario tipoUsuario
    -double valorMaterial
    ..Builder interno..
    +{static} Builder builder()
    +GetIdPrestamo() : string
    +GetTipoMulta() : TipoMulta
    +GetDiasRetraso() : int
    +GetTipoUsuario() : TipoUsuario
    +GetValorMaterial() : double
}

note right of ContextoMulta
  Fase 2 — Enriquecido:
  diasRetraso, tipoUsuario y valorMaterial
  se resuelven en DevolucionService ANTES
  de invocar los calculadores.
  Los calculadores ya no acceden a repositorios.
end note

class ContextoCreacionPrestamo {
